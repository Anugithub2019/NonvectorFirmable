    {
      "iteration": 0,
      "node": "propose",
      "changes": "initial proposal"
    },
    {
      "iteration": 1,
      "node": "revise",
      "changes": "Added `when` length matching conditions (^\\d{11}$ for ABN, ^\\d{9}$ for ACN) on CRED_LIC_ABN_ACN to prevent cross-type validation errors. Moved completely empty CRED_LIC_END_DT to unmapped to resolve 0-match warning and updated record.valid_to accordingly. Adjusted field confidence ratings and capped entity_type_from_name confidence to 0.70."
    },
    {
      "iteration": 2,
      "node": "revise",
      "changes": "Added person.full_name and person.role target mappings for CRED_LIC_NAME. Replaced regex matching on CRED_LIC_ABN_ACN with standard abn and acn transform ops with null_if for '0'. Standardized args into args_json format across all transforms."
    },
    {
      "iteration": 3,
      "node": "revise",
      "changes": "Added 'when' regex conditions on entity.abn (^\\d{11}$) and entity.acn (^\\d{1,9}$) to prevent ACNs from attempting ABN checksum validation and vice versa. Removed generic person.full_name and person.role mappings on corporate licensee names. Corrected transform args to use args_json format."
    },
    {
      "iteration": 4,
      "node": "revise",
      "changes": "1. Remapped CRED_LIC_AUTHORISATIONS from licence.authorisations to licence.conditions as instructed by reviewer feedback.\n2. Added pad transform with width 9 and fillchar '0' after null_if for entity.acn to handle ACN values with missing leading zeros."
    },
    {
      "iteration": 5,
      "node": "revise",
      "changes": "Replaced the unsupported 'pad' transform op with regex_replace ops to prepend leading zeros on 7 and 8 digit ACN values, resolving the blocking error while satisfying checksum validation."
    }
  ],
